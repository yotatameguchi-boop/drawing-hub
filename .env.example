# docker compose up -d の前に、このファイルを .env にコピーして値を入れてください。
# SESSION_SECRET は次のコマンドで作れます:  openssl rand -base64 32

SESSION_SECRET=
EDITOR_PASSWORD=          # 図面の取り込みとプライベート工事の閲覧ができる合言葉
VIEWER_PASSWORD=          # 閲覧と指摘だけの合言葉（空にすると閲覧専用ログインを無効化）
HOST_PORT=8080

# AI検図を使う場合のみ。空のままなら Drawing Hub 側で AI検図が自動的に無効になります。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
